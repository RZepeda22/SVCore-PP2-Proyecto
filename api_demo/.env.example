# Copia este archivo como .env y completa los valores. El .env no se sube al repositorio.
# Lo leen tanto Spring Boot como docker compose.
# En las contraseñas evita los caracteres $ ' " y \ (docker compose y MySQL los interpretan).

# --- Base de datos (docker compose levanta MySQL 8.4) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=svcore
DB_SSL_MODE=REQUIRED

# Administrador de MySQL (solo lo usa docker compose, nunca la API)
DB_ROOT_PASSWORD=

# Usuario de la API con privilegio mínimo (lo crea docker/mysql/01-app-user.sh)
DB_USERNAME=svcore_app
DB_PASS=

# --- JWT (HS256): mínimo 32 caracteres aleatorios ---
JWT_SECRET=
JWT_EXP_MINUTES=15

# Orígenes permitidos del frontend, separados por coma
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Contraseña de los usuarios de demostración (marco, ricardo, josemaria)
DEMO_PASSWORD=

# --- Hacienda ---
# mock = simulación (demo); api = API real de recepción de DTE (requiere credenciales del emisor)
HACIENDA_MODE=mock
# Solo en modo mock: false para iniciar en contingencia (también: PUT /api/config/hacienda-simulator)
HACIENDA_DISPONIBLE=true
HACIENDA_RETRY_MS=60000
# Solo en modo api
HACIENDA_API_URL=https://apitest.dtes.mh.gob.sv
HACIENDA_API_USER=
HACIENDA_API_PASSWORD=

# --- Firma de DTE ---
# Certificado del emisor en PKCS12. Si se deja vacío, se usa una llave de demostración en .svcore/
DTE_KEYSTORE_PATH=
DTE_KEYSTORE_PASSWORD=
DTE_KEY_ALIAS=
